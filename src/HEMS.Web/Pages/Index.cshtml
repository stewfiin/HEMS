@page
@model IndexModel
@{
    ViewData["Title"] = "Executive Fleet Dashboard";
}

<!-- Top KPI Summary Cards -->
<div class="row g-3 mb-4" id="kpi-cards">
    <div class="col-md-3">
        <div class="card card-stats p-3 bg-white border-start border-primary border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Physical Availability (PA)</h6>
                    <h2 class="mb-0 fw-bold text-primary" id="pa-metric">-- %</h2>
                </div>
                <div class="p-3 bg-primary bg-opacity-10 rounded-circle">
                    <i class="fa-solid fa-gauge-high fa-2x text-primary"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block" id="fleet-ratio">Operating vs Total Populasi</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stats p-3 bg-white border-start border-success border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Total Unit Armada</h6>
                    <h2 class="mb-0 fw-bold text-success" id="total-unit">--</h2>
                </div>
                <div class="p-3 bg-success bg-opacity-10 rounded-circle">
                    <i class="fa-solid fa-truck-pickup fa-2x text-success"></i>
                </div>
            </div>
            <small class="text-success mt-2 d-block"><span id="operating-unit">0</span> Sedang Beroperasi</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stats p-3 bg-white border-start border-danger border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Unit Breakdown</h6>
                    <h2 class="mb-0 fw-bold text-danger" id="breakdown-unit">--</h2>
                </div>
                <div class="p-3 bg-danger bg-opacity-10 rounded-circle">
                    <i class="fa-solid fa-triangle-exclamation fa-2x text-danger"></i>
                </div>
            </div>
            <small class="text-danger mt-2 d-block">Memerlukan Perbaikan</small>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card card-stats p-3 bg-white border-start border-warning border-4">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h6 class="text-muted text-uppercase mb-1" style="font-size: 0.8rem;">Work Orders Aktif</h6>
                    <h2 class="mb-0 fw-bold text-warning" id="active-wo">--</h2>
                </div>
                <div class="p-3 bg-warning bg-opacity-10 rounded-circle">
                    <i class="fa-solid fa-clipboard-list fa-2x text-warning"></i>
                </div>
            </div>
            <small class="text-muted mt-2 d-block" id="cache-indicator">Cache Redis: Memuat...</small>
        </div>
    </div>
</div>

<!-- Main Section: Telerik Kendo UI Grid for Fleet Management -->
<div class="row mb-4">
    <div class="col-lg-8">
        <div class="card card-stats p-4 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-list-check me-2 text-primary"></i>Katalog Armada & Telematika Hour Meter</h5>
                <button class="btn btn-sm btn-outline-secondary" onclick="reloadGrid()">
                    <i class="fa-solid fa-rotate me-1"></i> Refresh Grid
                </button>
            </div>
            <div id="equipmentGrid"></div>
        </div>
    </div>

    <!-- Quick Action: Log Hour Meter & Top Breakdown Units -->
    <div class="col-lg-4">
        <!-- Log HM Card -->
        <div class="card card-stats p-4 bg-white mb-4">
            <h5 class="fw-bold mb-3"><i class="fa-solid fa-stopwatch me-2 text-primary"></i>Input Log Hour Meter (HM)</h5>
            <form id="formLogHM">
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Pilih Unit Alat Berat</label>
                    <select class="form-select form-select-sm" id="selectEquipment" required></select>
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Hour Meter Baru</label>
                    <input type="number" step="0.1" class="form-control form-control-sm" id="inputNewHM" placeholder="Contoh: 255.5" required />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-semibold">Dicatat Oleh (User/Operator)</label>
                    <input type="text" class="form-control form-control-sm" id="inputRecordedBy" value="Planner-1" required />
                </div>
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-bold">
                    <i class="fa-solid fa-paper-plane me-1"></i> Simpan Log HM
                </button>
            </form>
            <div id="hmAlert" class="mt-3" style="display:none;"></div>
        </div>

        <!-- Top Breakdown Units Card -->
        <div class="card card-stats p-4 bg-white">
            <h5 class="fw-bold mb-3 text-danger"><i class="fa-solid fa-chart-pie me-2"></i>Frekuensi Breakdown Tertinggi</h5>
            <ul class="list-group list-group-flush" id="topBreakdownList">
                <li class="list-group-item text-muted small">Belum ada riwayat kerusakan unit.</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let equipmentsCache = [];

    $(document).ready(function() {
        loadDashboardSummary();
        initEquipmentGrid();
    });

    // 1. Ambil Ringkasan Dashboard (Memakai Redis Cache)
    function loadDashboardSummary() {
        $.getJSON('/api/v1/dashboard/summary', function(data) {
            $('#pa-metric').text(data.physicalAvailability + ' %');
            $('#total-unit').text(data.totalEquipment);
            $('#operating-unit').text(data.operatingCount);
            $('#breakdown-unit').text(data.breakdownCount);
            $('#active-wo').text(data.activeWorkOrders);
            $('#fleet-ratio').text(`${data.operatingCount} dari ${data.totalEquipment} unit siap jalan`);

            let cacheText = data.fromCache ? '<i class="fa-solid fa-bolt text-info"></i> Dilayani dari Redis Cache' : '<i class="fa-solid fa-database text-muted"></i> Data Segar dari SQL Server';
            $('#cache-indicator').html(cacheText);

            // Render Top Breakdown List
            if (data.topBreakdownUnits && data.topBreakdownUnits.length > 0) {
                let html = '';
                data.topBreakdownUnits.forEach(u => {
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <div>
                                    <span class="fw-bold">${u.equipmentCode}</span>
                                    <small class="text-muted d-block">${u.model}</small>
                                </div>
                                <span class="badge bg-danger rounded-pill">${u.breakdownCount}x breakdown</span>
                             </li>`;
                });
                $('#topBreakdownList').html(html);
            }
        });
    }

    // 2. Inisialisasi Telerik Kendo UI Grid
    function initEquipmentGrid() {
        $("#equipmentGrid").kendoGrid({
            dataSource: {
                transport: {
                    read: {
                        url: "/api/v1/equipments",
                        dataType: "json"
                    }
                },
                schema: {
                    model: {
                        id: "id",
                        fields: {
                            id: { type: "number" },
                            equipmentCode: { type: "string" },
                            brand: { type: "string" },
                            model: { type: "string" },
                            currentHourMeter: { type: "number" },
                            lastServiceHourMeter: { type: "number" },
                            status: { type: "string" },
                            siteLocation: { type: "string" },
                            needsServiceAlert: { type: "boolean" }
                        }
                    }
                },
                pageSize: 10
            },
            height: 480,
            pageable: true,
            sortable: true,
            filterable: true,
            columns: [
                { field: "equipmentCode", title: "Kode Unit", width: "110px", template: "<strong>#: equipmentCode #</strong>" },
                { field: "model", title: "Model / Tipe", width: "150px", template: "#: brand # #: model #" },
                { field: "currentHourMeter", title: "HM Terakhir", width: "120px", template: "#: kendo.toString(currentHourMeter, 'n1') # HM" },
                { field: "siteLocation", title: "Lokasi Site", width: "130px" },
                { 
                    field: "status", 
                    title: "Status", 
                    width: "120px",
                    template: function(data) {
                        if (data.status === "Operating") return '<span class="badge badge-op">Operating</span>';
                        if (data.status === "Breakdown") return '<span class="badge badge-bd">Breakdown</span>';
                        if (data.status === "UnderMaintenance") return '<span class="badge badge-mnt">Maintenance</span>';
                        return '<span class="badge badge-stb">Standby</span>';
                    }
                },
                {
                    field: "needsServiceAlert",
                    title: "Jadwal Servis",
                    width: "130px",
                    template: function(data) {
                        return data.needsServiceAlert 
                            ? '<span class="badge bg-warning text-dark"><i class="fa-solid fa-bell me-1"></i>Due Service!</span>' 
                            : '<span class="badge bg-light text-secondary">Normal</span>';
                    }
                }
            ],
            dataBound: function(e) {
                // Populate dropdown equipment select
                let items = this.dataSource.data();
                equipmentsCache = items;
                let select = $('#selectEquipment');
                select.empty();
                items.forEach(eq => {
                    select.append(`<option value="${eq.id}">${eq.equipmentCode} - ${eq.model} (HM: ${eq.currentHourMeter})</option>`);
                });
            }
        });
    }

    function reloadGrid() {
        $("#equipmentGrid").data("kendoGrid").dataSource.read();
        loadDashboardSummary();
    }

    // 3. Submit Log Hour Meter
    $('#formLogHM').submit(function(e) {
        e.preventDefault();
        let eqId = $('#selectEquipment').val();
        let payload = {
            newHourMeter: parseFloat($('#inputNewHM').val()),
            recordedBy: $('#inputRecordedBy').val()
        };

        $.ajax({
            url: `/api/v1/equipments/${eqId}/hm-logs`,
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function(res) {
                let alertClass = res.preventiveMaintenanceDue ? 'alert-warning' : 'alert-success';
                let icon = res.preventiveMaintenanceDue ? 'fa-triangle-exclamation' : 'fa-circle-check';
                $('#hmAlert').removeClass().addClass(`alert ${alertClass} small py-2`).html(`<i class="fa-solid ${icon} me-1"></i> ${res.message}`).show();
                reloadGrid();
            },
            error: function(xhr) {
                let err = xhr.responseJSON ? xhr.responseJSON.message : "Terjadi kesalahan.";
                $('#hmAlert').removeClass().addClass('alert alert-danger small py-2').html(`<i class="fa-solid fa-circle-xmark me-1"></i> ${err}`).show();
            }
        });
    });
</script>
}
